ADMIN_KEY=personascan-admin
SITE_URL=http://localhost:5173
# Production scan links (separate from marketing personascan.net):
SCAN_SITE_URL=https://secure.personascan.net

# Persona Scan isolated schema on dep3
SUPABASE_URL=https://hxapjyxzvmouwrhdgmsx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Worker (secure.personascan.net)
# Runtime:  pnpm cf:secrets   then  pnpm cf:deploy

# Invite email (Resend) — from address must be verified in Resend for personascan.net
# Also set on Supabase Edge Functions:
#   supabase secrets set RESEND_API_KEY=re_... EMAIL_FROM='Persona Scan <noreply@personascan.net>' ADMIN_KEY=... --project-ref hxapjyxzvmouwrhdgmsx
RESEND_API_KEY=
EMAIL_FROM=Persona Scan <noreply@personascan.net>
VITE_SUPABASE_FUNCTIONS_URL=https://hxapjyxzvmouwrhdgmsx.supabase.co/functions/v1
VITE_SUPABASE_ANON_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# Threat intel — ALL OPTIONAL. Browser probes are real without any of these.
# “Public” = usable with no key or a free signup. Never shown on the scan UI.
# ═══════════════════════════════════════════════════════════════════════════

# Public / free without signup (rate-limited)
# PhishTank works with an empty key; optional free app key raises limits:
PHISHTANK_API_KEY=
# NVD CVE is public without a key; optional key raises limits:
NVD_API_KEY=

# Free after signup (not open-public — you still register a key)
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# Private / partner keys (Web3)
SCAMSNIFFER_API_KEY=
SCAMSNIFFER_API_URL=https://api.scamsniffer.io
BLOCKAID_API_KEY=
BLOCKAID_API_URL=https://api.blockaid.io

# Native-only (not available in a web page — leave off unless you ship an app agent)
GOOGLE_PLAY_INTEGRITY_ENABLED=0
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
APPSEALING_VERIFY_URL=
APPSEALING_API_KEY=
DEXGUARD_ENABLED=0
APPROOV_SECRET=
APPROOV_VERIFY_URL=

# Optional lab / enterprise
MOBSF_URL=
MOBSF_API_KEY=
MOBSF_SAMPLE_HASH=
SNYK_TOKEN=
SNYK_ORG_ID=
SNYK_PROJECT_ID=
YARA_API_URL=
YARA_API_KEY=
CLAMAV_API_URL=
CLAMAV_API_KEY=
