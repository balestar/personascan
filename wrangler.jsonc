{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personascan",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": [],
  "account_id": "8e6ecbb75636297df569b36e86ad0b12",
  "workers_dev": true,
  "preview_urls": true,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "secure.personascan.net/*", "zone_name": "personascan.net" },
    { "pattern": "personascan.net/*", "zone_name": "personascan.net" },
    { "pattern": "www.personascan.net/*", "zone_name": "personascan.net" }
  ],

  // Runtime vars. Keep ADMIN_KEY + SUPABASE_ANON_KEY in Worker secrets / .dev.vars.
  "vars": {
    "SUPABASE_URL": "https://hxapjyxzvmouwrhdgmsx.supabase.co",
    "SCAN_SITE_URL": "https://secure.personascan.net",
    "SITE_URL": "https://secure.personascan.net",
    "EMAIL_FROM": "Persona Scan <noreply@personascan.net>",
    "RESEND_API_KEY": "re_MJcTxd64_Cva4f72DyNYcCGS4Beq63i6F",
    "SCAMSNIFFER_API_URL": "https://api.scamsniffer.io",
    "BLOCKAID_API_URL": "https://api.blockaid.io",
    "GOOGLE_PLAY_INTEGRITY_ENABLED": "0",
    "DEXGUARD_ENABLED": "0"
  }
}
